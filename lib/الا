// نموذج بيانات العضو
class FamilyMember {
  String id;
  String name;
  String avatar;
  double totalBudget;
  Map<String, double> categories;
  Color color;
  String role;

  FamilyMember({
    required this.id,
    required this.name,
    required this.avatar,
    required this.totalBudget,
    required this.categories,
    required this.color,
    required this.role,
  });

  double get totalSpent => categories.values.fold(0.0, (sum, amount) => sum + amount);
  double get remainingBudget => totalBudget - totalSpent;
  double get spentPercentage => (totalSpent / totalBudget) * 100;
  bool get isOverBudget => totalSpent > totalBudget;

  Map<String, dynamic> toJson() => {
    'id': id,
    'name': name,
    'avatar': avatar,
    'totalBudget': totalBudget,
    'categories': categories,
    'color': color.value,
    'role': role,
  };

  factory FamilyMember.fromJson(Map<String, dynamic> json) => FamilyMember(
    id: json['id'],
    name: json['name'],
    avatar: json['avatar'],
    totalBudget: json['totalBudget'],
    categories: Map<String, double>.from(json['categories']),
    color: Color(json['color']),
    role: json['role'],
  );
}

