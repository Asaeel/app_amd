import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'dart:convert';
import 'dart:math';

void main() {
  runApp(FamilyExpenseApp());
}

class FamilyExpenseApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'محلل المصروفات العائلية',
      theme: ThemeData(
        primarySwatch: Colors.blue,
        fontFamily: 'Cairo',
      ),
      home: ExpenseAnalyzerScreen(),
      debugShowCheckedModeBanner: false,
    );
  }
}

class FamilyMember {
  String name;
  String avatar;
  double limit;
  double spent;
  Color color;

  FamilyMember({
    required this.name,
    required this.avatar,
    required this.limit,
    required this.spent,
    required this.color,
  });

  double get percentage => (spent / limit) * 100;
  bool get isOverLimit => spent > limit;
  double get excess => spent - limit;

  Map<String, dynamic> toJson() => {
    'name': name,
    'avatar': avatar,
    'limit': limit,
    'spent': spent,
    'color': color.value,
  };

  factory FamilyMember.fromJson(Map<String, dynamic> json) => FamilyMember(
    name: json['name'],
    avatar: json['avatar'],
    limit: json['limit'],
    spent: json['spent'],
    color: Color(json['color']),
  );
}

class AIAnalysis {
  String message;
  String emoji;
  Color color;

  AIAnalysis({required this.message, required this.emoji, required this.color});
}

class ExpenseAnalyzerScreen extends StatefulWidget {
  @override
  _ExpenseAnalyzerScreenState createState() => _ExpenseAnalyzerScreenState();
}

class _ExpenseAnalyzerScreenState extends State<ExpenseAnalyzerScreen>
    with TickerProviderStateMixin {
  
  List<FamilyMember> familyMembers = [
    FamilyMember(
      name: 'أحمد',
      avatar: '👨',
      limit: 3000,
      spent: 0,
      color: Color(0xFFFF6B6B),
    ),
    FamilyMember(
      name: 'فاطمة',
      avatar: '👩',
      limit: 200,
      spent: 0,
      color: Color(0xFF4ECDC4),
    ),
    FamilyMember(
      name: 'محمد',
      avatar: '👦',
      limit: 778,
      spent: 0,
      color: Color(0xFF45B7D1),
    ),
  ];

  String selectedPerson = 'أحمد';
  TextEditingController amountController = TextEditingController();
  AIAnalysis? currentAnalysis;
  late AnimationController _animationController;
  late Animation<double> _fadeAnimation;

  @override
  void initState() {
    super.initState();
    _animationController = AnimationController(
      duration: Duration(milliseconds: 800),
      vsync: this,
    );
    _fadeAnimation = Tween<double>(begin: 0.0, end: 1.0).animate(
      CurvedAnimation(parent: _animationController, curve: Curves.easeInOut),
    );
    loadData();
  }

  @override
  void dispose() {
    _animationController.dispose();
    amountController.dispose();
    super.dispose();
  }

  // تحميل البيانات من SharedPreferences
  Future<void> loadData() async {
    SharedPreferences prefs = await SharedPreferences.getInstance();
    String? savedData = prefs.getString('familyExpenses');
    
    if (savedData != null) {
      Map<String, dynamic> data = json.decode(savedData);
      setState(() {
        for (int i = 0; i < familyMembers.length; i++) {
          String memberName = familyMembers[i].name;
          if (data.containsKey(memberName)) {
            familyMembers[i].spent = data[memberName]['spent']?.toDouble() ?? 0.0;
          }
        }
      });
    }
  }

  // حفظ البيانات في SharedPreferences
  Future<void> saveData() async {
    SharedPreferences prefs = await SharedPreferences.getInstance();
    Map<String, dynamic> data = {};
    
    for (FamilyMember member in familyMembers) {
      data[member.name] = {'spent': member.spent};
    }
    
    await prefs.setString('familyExpenses', json.encode(data));
  }

  // تحليل الإنفاق بالذكاء الاصطناعي
  AIAnalysis analyzeExpense(FamilyMember member, double amount) {
    double percentage = member.percentage;
    
    if (amount > member.limit * 0.3) {
      return AIAnalysis(
        message: 'تحذير: مصروف كبير (${amount.toInt()} ريال) لـ ${member.name}. هذا المبلغ يشكل ${((amount/member.limit)*100).toStringAsFixed(1)}% من الميزانية!',
        emoji: '🚨',
        color: Colors.red,
      );
    } else if (percentage > 100) {
      return AIAnalysis(
        message: 'خطر: ${member.name} تجاوز الحد الأعلى! المبلغ الزائد: ${member.excess.toInt()} ريال',
        emoji: '🔴',
        color: Colors.red,
      );
    } else if (percentage > 80) {
      return AIAnalysis(
        message: 'تنبيه: ${member.name} اقترب من الحد الأعلى (${percentage.toStringAsFixed(1)}%). يُنصح بتقليل الإنفاق',
        emoji: '🟡',
        color: Colors.orange,
      );
    } else if (percentage > 50) {
      return AIAnalysis(
        message: 'معلومة: ${member.name} استخدم ${percentage.toStringAsFixed(1)}% من الميزانية. الوضع طبيعي',
        emoji: '🟢',
        color: Colors.green,
      );
    } else {
      return AIAnalysis(
        message: 'ممتاز: إنفاق ${member.name} ضمن المعدل المثالي (${percentage.toStringAsFixed(1)}%)',
        emoji: '✅',
        color: Colors.green,
      );
    }
  }

  // إضافة مصروف جديد
  void addExpense() {
    double? amount = double.tryParse(amountController.text);
    
    if (amount == null || amount <= 0) {
      _showErrorDialog('يرجى إدخال مبلغ صحيح أكبر من صفر');
      return;
    }

    FamilyMember member = familyMembers.firstWhere((m) => m.name == selectedPerson);
    member.spent += amount;

    // تحليل الإنفاق
    AIAnalysis analysis = analyzeExpense(member, amount);
    
    setState(() {
      currentAnalysis = analysis;
    });

    // تشغيل الأنيميشن
    _animationController.forward().then((_) {
      Future.delayed(Duration(seconds: 4), () {
        if (mounted) {
          _animationController.reverse();
        }
      });
    });

    // التحقق من تجاوز الحد الأعلى
    if (member.isOverLimit) {
      _showLimitExceededDialog(member);
    }

    // حفظ البيانات
    saveData();
    
    // مسح حقل الإدخال
    amountController.clear();
  }

  // عرض نافذة خطأ
  void _showErrorDialog(String message) {
    showDialog(
      context: context,
      builder: (BuildContext context) {
        return AlertDialog(
          title: Row(
            children: [
              Icon(Icons.error, color: Colors.red),
              SizedBox(width: 10),
              Text('خطأ'),
            ],
          ),
          content: Text(message),
          actions: [
            TextButton(
              onPressed: () => Navigator.of(context).pop(),
              child: Text('حسناً'),
            ),
          ],
        );
      },
    );
  }

